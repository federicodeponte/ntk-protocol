{
  "version": "0.2.0",
  "description": "Cross-implementation conformance cases for the Need-to-Know protocol. Each case runs check_reply with the LLM judge off; `facts` is a path relative to the repo root or an inline facts document; `policy` overrides the facts file's policy; `now` defaults to 1000.0. Both the Python and the TypeScript test suites assert every `expect` block. Regenerate with python3 conformance/generate.py and review the diff.",
  "cases": [
    {
      "name": "check1: public fact is fine for anyone",
      "facts": "examples/maya_facts.json",
      "request": {
        "requester": "x-agent",
        "role": "stranger",
        "purpose": "plan a study"
      },
      "draft": "Read the published paper.",
      "expect": {
        "allowed": true,
        "send": "Read the published paper.",
        "reasons": [],
        "consent_fact_ids": [],
        "disclosed": {
          "paper": "public"
        }
      }
    },
    {
      "name": "check1: role label is fine for that role",
      "facts": "examples/maya_facts.json",
      "request": {
        "requester": "jun-agent",
        "role": "collaborator",
        "purpose": "plan a study"
      },
      "draft": "Her code is on the repo.",
      "expect": {
        "allowed": true,
        "send": "Her code is on the repo.",
        "reasons": [],
        "consent_fact_ids": [],
        "disclosed": {
          "methods": "role:collaborator"
        }
      }
    },
    {
      "name": "check1: role label for another role becomes a consent request",
      "facts": "examples/maya_facts.json",
      "request": {
        "requester": "x-agent",
        "role": "stranger",
        "purpose": "plan a study"
      },
      "draft": "Her code is on the repo.",
      "expect": {
        "allowed": false,
        "send": "I can't share that.",
        "reasons": [
          "check1 who's asking: 'methods' label role:collaborator not visible to role stranger -> consent request"
        ],
        "consent_fact_ids": [
          "methods"
        ],
        "disclosed": {}
      }
    },
    {
      "name": "check1: unlisted purpose is not minimised",
      "facts": "examples/maya_facts.json",
      "request": {
        "requester": "jun-agent",
        "role": "collaborator",
        "purpose": "write a grant"
      },
      "draft": "Her code is on the repo.",
      "expect": {
        "allowed": true,
        "send": "Her code is on the repo.",
        "reasons": [],
        "consent_fact_ids": [],
        "disclosed": {
          "methods": "role:collaborator"
        }
      }
    },
    {
      "name": "check1: purpose that does not need the topic becomes a consent request",
      "facts": "examples/maya_facts.json",
      "request": {
        "requester": "jun-agent",
        "role": "collaborator",
        "purpose": "write a grant"
      },
      "draft": "Her code is on the repo.",
      "policy": {
        "purpose_needs": {
          "write a grant": [
            "paper"
          ]
        }
      },
      "expect": {
        "allowed": false,
        "send": "I can't share that.",
        "reasons": [
          "check1 who's asking: 'methods' purpose 'write a grant' does not need it -> consent request"
        ],
        "consent_fact_ids": [
          "methods"
        ],
        "disclosed": {}
      }
    },
    {
      "name": "grants: active grant allows",
      "facts": "examples/maya_facts.json",
      "request": {
        "requester": "x-agent",
        "role": "stranger",
        "purpose": "plan a study"
      },
      "draft": "Here is her code.",
      "policy": {
        "purpose_needs": {
          "plan a study": [
            "paper",
            "methods"
          ]
        },
        "grants": [
          {
            "fact_id": "methods",
            "requester": "x-agent",
            "purpose": "plan a study",
            "expires_at": 1060.0,
            "revoked": false
          }
        ]
      },
      "now": 1030.0,
      "expect": {
        "allowed": true,
        "send": "Here is her code.",
        "reasons": [],
        "consent_fact_ids": [],
        "disclosed": {
          "methods": "owner grant"
        }
      }
    },
